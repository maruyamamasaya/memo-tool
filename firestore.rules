rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow write: if false;
    }

    match /memos/{memoId} {
      allow read, delete: if isGroupMember(resource.data.groupId);

      allow create: if isGroupMember(request.resource.data.groupId)
        && request.resource.data.keys().hasOnly([
          'groupId', 'title', 'body', 'createdBy', 'createdByName', 'createdAt',
          'updatedBy', 'updatedByName', 'updatedAt', 'type', 'pinned'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.type in ['text', 'checklist', 'snippet']
        && request.resource.data.pinned is bool
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isGroupMember(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByName == resource.data.createdByName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'type', 'pinned', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.type in ['text', 'checklist', 'snippet']
        && request.resource.data.pinned is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }
  }
}
